    {
      "id": "stats-code",
      "type": "code",
      "position": {
        "x": 910,
        "y": 1290
      },
      "data": {
        "code": "from collections import Counter\n\n\ndef run(data, env):\n    words = [w.strip(\".,!?:;()\\\"'«»\").lower() for w in data[\"text\"].split()]\n    words = [w for w in words if len(w) >= data[\"min_len\"]]\n    print(f\"слов после фильтра: {len(words)}\")\n    top = Counter(words).most_common(data[\"top\"])\n    return {\n        \"word_count\": len(words),\n        \"top_words\": [{\"word\": w, \"count\": c} for w, c in top],\n    }\n",
        "outputs": [
          "word_count",
          "top_words"
        ],
        "timeout": 2,
        "memory_mb": 128
      },
      "measured": {
        "width": 230,
        "height": 128
      }
    },
